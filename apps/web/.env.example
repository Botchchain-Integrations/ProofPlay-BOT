# BOT Chain mainnet (677) is the default. Testnet (968) is reachable via the navbar toggle.
# Contract addresses default in source (lib/contracts.ts); these override per network.

# Mainnet (677) deployed contract addresses
NEXT_PUBLIC_MAINNET_FACTORY_ADDRESS=0x71601e379643e8dD704991C6dD1FDbD5630C4Ce7
NEXT_PUBLIC_MAINNET_REGISTRY_ADDRESS=0x0C70fb68D234E116859e85B2B38346b3064CaB9F

# Testnet (968) deployed contract addresses
NEXT_PUBLIC_TESTNET_FACTORY_ADDRESS=0xf6920D45d16c5FAa9eB40753Bb3F16D353355705
NEXT_PUBLIC_TESTNET_REGISTRY_ADDRESS=0xfEbCDDA771561Bc92D290C993e07Aa8552083A61

# Optional RPC override (defaults to the chain's bundled RPC per network)
NEXT_PUBLIC_BOT_RPC_URL=

# RainbowKit / WalletConnect project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Football API key - API-Football via RapidAPI. Server-side only.
FOOTBALL_API_KEY=

# Registry owner private key - used server-side to auto-seed player pools on-chain.
# Never commit this; use the Vercel dashboard / a secrets store in production.
DEPLOYER_PRIVATE_KEY=